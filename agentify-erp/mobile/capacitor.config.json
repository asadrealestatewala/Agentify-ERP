{
  "appId": "co.agentifyerp.app",
  "appName": "Agentify ERP",
  "webDir": "www",
  "server": {
    "url": "https://agentifyerp.co",
    "cleartext": false,
    "allowNavigation": [
      "agentifyerp.co",
      "*.agentifyerp.co"
    ]
  },
  "android": {
    "allowMixedContent": false
  },
  "backgroundColor": "#f4f9f7",
  "plugins": {
    "SplashScreen": {
      "backgroundColor": "#0e7c6b",
      "launchAutoHide": true
    },
    "StatusBar": {
      "backgroundColor": "#0e7c6b",
      "style": "DARK"
    }
  }
}
