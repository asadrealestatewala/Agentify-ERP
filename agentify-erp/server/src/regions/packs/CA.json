{
  "code": "CA",
  "name": "Canada",
  "status": "active",
  "version": 4,
  "locale": "en-CA",
  "language": "en",
  "languages": [ "en", "fr" ],
  "currency": "CAD",
  "money_scale": 2,
  "currency_style": "intl",
  "date_style": "YYYY-MM-DD",
  "time_style": "12h",
  "timezone": "America/Toronto",
  "work_week": { "weekend": [0, 6], "note": "Default only; each workspace sets its own weekend in HR > Onboarding > Working calendar." },
  "units_system": "imperial",
  "area_units": [ "sqft", "sqm", "acre", "hectare" ],
  "default_area_unit": "sqft",
  "phone": {
    "calling_code": "1",
    "trunk": "1",
    "match_tail": 0,
    "national_length": [
      10
    ],
    "example": "+1 416 555 0100"
  },
  "sub_region_label": "Province / territory",
  "sub_regions": [ "Alberta", "British Columbia", "Manitoba", "New Brunswick", "Newfoundland and Labrador", "Northwest Territories", "Nova Scotia", "Nunavut", "Ontario", "Prince Edward Island", "Quebec", "Saskatchewan", "Yukon" ],
  "terminology": {
    "customer": "Client"
  },
  "identity": {
    "national_id": {
      "label": "SIN (last 4 shown)",
      "pattern": "^\\d{3}-?\\d{3}-?\\d{3}$",
      "encrypted": true
    }
  },
  "flags": {
    "mortgage": true,
    "transactions": false,
    "compliance": true,
    "templates": true
  },
  "rules": [],
  "notes": "Phase 1 manifest only. Quebec requires French: fr-CA arrives with the translation phase.",
  "ext_fields": [
    {
      "entity": "contact",
      "key": "residency_province",
      "label": "Province of residence",
      "type": "select",
      "options": "sub_regions"
    },
    {
      "entity": "property",
      "key": "pid_number",
      "label": "PID / roll number",
      "type": "text"
    },
    {
      "entity": "property",
      "key": "condo_fee_monthly",
      "label": "Condo fee (monthly)",
      "type": "money"
    },
    {
      "entity": "property",
      "key": "year_built",
      "label": "Year built",
      "type": "number"
    }
  ],
  "mortgage_compounding": "semiannual",
  "templates": [
    {
      "kind": "offer",
      "name": "Offer to purchase (sample)",
      "language": "en",
      "needs_legal_review": true,
      "body": "SAMPLE WORDING. This template is a starting point only and is not legal advice. Have it reviewed by a licensed professional in your jurisdiction before use.\n\nOFFER TO PURCHASE\n\nDate: {{today|date}}\n{{company.name}} presents this offer on behalf of {{buyer.name}} (the Buyer) to {{seller.name}} (the Seller).\n\nProperty: {{property.title}}, {{property.address}}\nOffered price: {{price|money}}\nDeposit: {{deposit|money}}\nProposed closing date: {{closing_date|date}}\n\nThis offer is subject to the conditions agreed in writing between the parties.\n"
    },
    {
      "kind": "agency_agreement",
      "name": "Agency agreement (sample)",
      "language": "en",
      "needs_legal_review": true,
      "body": "SAMPLE WORDING. This template is a starting point only and is not legal advice. Have it reviewed by a licensed professional in your jurisdiction before use.\n\nAGENCY AGREEMENT\n\n{{company.name}} is appointed by {{client.name}} (the Seller) to market {{property.title}}, {{property.address}}.\nCommission: {{commission_percent}}% of the sale price.\nTerm: {{start_date|date}} to {{end_date|date}}.\n\nSigned on {{today|date}}.\n"
    },
    {
      "kind": "receipt_note",
      "name": "Payment receipt note",
      "language": "en",
      "needs_legal_review": false,
      "body": "Received from {{client.name}} the sum of {{amount|money}} by {{method}} (reference {{reference}}) on {{today|date}}.\n{{company.name}}\n"
    }
  ],
  "checklists": [
    {
      "key": "ca_purchase",
      "name": "Purchase checklist",
      "applies_to": "sale",
      "needs_legal_review": true,
      "items": [
        {
          "key": "id_verified",
          "label": "Client identification verified and recorded",
          "required": true
        },
        {
          "key": "listing_signed",
          "label": "Listing or buyer representation agreement signed",
          "required": true
        },
        {
          "key": "deposit",
          "label": "Deposit received in trust and recorded",
          "required": true
        },
        {
          "key": "conditions",
          "label": "Conditions (financing, inspection) tracked to their deadlines",
          "required": false
        },
        {
          "key": "lawyer",
          "label": "Real estate lawyer or notary instructed",
          "required": true
        }
      ]
    }
  ],
  "price_style": "intl",
  "property_types": [
    {
      "group": "Houses",
