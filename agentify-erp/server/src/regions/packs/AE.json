  "distance_unit": "km",
  "area_units": [ "sqft", "sqm" ],
  "default_area_unit": "sqft",
  "phone": {
    "calling_code": "971",
    "trunk": "0",
    "match_tail": 0,
    "national_length": [
      8,
      9
    ],
    "example": "+971 50 123 4567"
  },
  "sub_region_label": "Emirate",
  "sub_regions": [ "Abu Dhabi", "Dubai", "Sharjah", "Ajman", "Umm Al Quwain", "Ras Al Khaimah", "Fujairah" ],
  "terminology": {
    "customer": "Client"
  },
  "identity": {
    "national_id": {
      "label": "Emirates ID",
      "pattern": "^784-?\\d{4}-?\\d{7}-?\\d$",
      "encrypted": true
    }
  },
  "flags": {
    "mortgage": true,
    "transactions": false,
