{
  "code": "AE",
  "name": "United Arab Emirates",
  "status": "active",
  "version": 4,
  "locale": "en-AE",
  "language": "en",
  "languages": [ "en", "ar" ],
  "currency": "AED",
  "money_scale": 2,
  "currency_style": "intl",
