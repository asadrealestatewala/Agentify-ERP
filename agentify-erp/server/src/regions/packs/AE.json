    {
      "entity": "contact",
      "key": "nationality",
      "label": "Nationality",
      "type": "text"
    },
    {
      "entity": "property",
      "key": "title_deed_no",
      "label": "Title deed number",
      "type": "text"
    },
    {
      "entity": "property",
      "key": "rera_permit_no",
      "label": "RERA / Trakheesi permit no.",
      "type": "text"
    },
    {
      "entity": "property",
      "key": "service_charge",
      "label": "Service charge (yearly)",
      "type": "money"
    }
  ],
  "templates": [
    {
      "kind": "offer",
      "name": "Offer to purchase (sample)",
      "language": "en",
      "needs_legal_review": true,
      "body": "SAMPLE WORDING. This template is a starting point only and is not legal advice. Have it reviewed by a licensed professional in your jurisdiction before use.\n\nOFFER TO PURCHASE\n\nDate: {{today|date}}\n{{company.name}} presents this offer on behalf of {{buyer.name}} (the Buyer) to {{seller.name}} (the Seller).\n\nProperty: {{property.title}}, {{property.address}}\nOffered price: {{price|money}}\nDeposit: {{deposit|money}}\nProposed closing date: {{closing_date|date}}\n\nThis offer is subject to the conditions agreed in writing between the parties.\n"
    },
    {
      "kind": "agency_agreement",
      "name": "Agency agreement (sample)",
      "language": "en",
      "needs_legal_review": true,
      "body": "SAMPLE WORDING. This template is a starting point only and is not legal advice. Have it reviewed by a licensed professional in your jurisdiction before use.\n\nAGENCY AGREEMENT\n\n{{company.name}} is appointed by {{client.name}} (the Seller) to market {{property.title}}, {{property.address}}.\nCommission: {{commission_percent}}% of the sale price.\nTerm: {{start_date|date}} to {{end_date|date}}.\n\nSigned on {{today|date}}.\n"
    },
    {
      "kind": "receipt_note",
      "name": "Payment receipt note",
      "language": "en",
      "needs_legal_review": false,
      "body": "Received from {{client.name}} the sum of {{amount|money}} by {{method}} (reference {{reference}}) on {{today|date}}.\n{{company.name}}\n"
    }
  ],
  "checklists": [
    {
      "key": "ae_sale",
      "name": "Sale checklist",
      "applies_to": "sale",
