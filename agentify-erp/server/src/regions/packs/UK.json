{
  "code": "UK",
  "name": "United Kingdom",
  "status": "active",
  "version": 4,
  "locale": "en-GB",
  "language": "en",
  "languages": [ "en" ],
  "currency": "GBP",
  "money_scale": 2,
  "currency_style": "intl",
  "date_style": "DD/MM/YYYY",
  "time_style": "24h",
  "timezone": "Europe/London",
  "units_system": "mixed",
  "distance_unit": "mi",
  "area_units": [ "sqft", "sqm", "acre", "hectare" ],
  "default_area_unit": "sqft",
  "phone": {
    "calling_code": "44",
    "trunk": "0",
    "match_tail": 0,
    "national_length": [
      10
    ],
    "example": "+44 7700 900123"
  },
  "sub_region_label": "Nation",
  "sub_regions": [ "England", "Wales", "Scotland", "Northern Ireland" ],
  "terminology": {
    "agent": "Estate Agent",
    "customer": "Client",
    "seller": "Vendor",
    "buyer": "Purchaser"
  },
  "identity": {
    "national_id": {
      "label": "National Insurance number",
      "pattern": "^[A-Za-z]{2}\\d{6}[A-Za-z]$",
      "encrypted": true
    }
  },
  "flags": {
    "mortgage": true,
    "transactions": false,
    "compliance": true,
    "lettings": true,
    "templates": true
  },
  "rules": [],
  "notes": "Phase 1 manifest only. Law differs by nation, so sub_region drives the rules.",
  "ext_fields": [
    {
      "entity": "contact",
      "key": "nation_of_residence",
      "label": "Nation of residence",
      "type": "select",
      "options": "sub_regions"
    },
    {
      "entity": "property",
      "key": "title_number",
      "label": "Land Registry title number",
      "type": "text"
    },
    {
      "entity": "property",
      "key": "tenure",
      "label": "Tenure",
      "type": "select",
      "options": [ "Freehold", "Leasehold", "Commonhold" ]
    },
    {
      "entity": "property",
      "key": "epc_rating",
      "label": "EPC rating",
      "type": "select",
      "options": [ "A", "B", "C", "D", "E", "F", "G" ]
    },
    {
      "entity": "property",
      "key": "council_tax_band",
      "label": "Council tax band",
      "type": "select",
      "options": [ "A", "B", "C", "D", "E", "F", "G", "H" ]
    }
  ],
  "templates": [
    {
      "kind": "offer",
      "name": "Offer to purchase (sample)",
      "language": "en",
      "needs_legal_review": true,
      "body": "SAMPLE WORDING. This template is a starting point only and is not legal advice. Have it reviewed by a licensed professional in your jurisdiction before use.\n\nOFFER TO PURCHASE\n\nDate: {{today|date}}\n{{company.name}} presents this offer on behalf of {{buyer.name}} (the Purchaser) to {{seller.name}} (the Vendor).\n\nProperty: {{property.title}}, {{property.address}}\nOffered price: {{price|money}}\nDeposit: {{deposit|money}}\nProposed closing date: {{closing_date|date}}\n\nThis offer is subject to the conditions agreed in writing between the parties.\n"
    },
    {
      "kind": "agency_agreement",
      "name": "Agency agreement (sample)",
      "language": "en",
      "needs_legal_review": true,
      "body": "SAMPLE WORDING. This template is a starting point only and is not legal advice. Have it reviewed by a licensed professional in your jurisdiction before use.\n\nAGENCY AGREEMENT\n\n{{company.name}} is appointed by {{client.name}} (the Vendor) to market {{property.title}}, {{property.address}}.\nCommission: {{commission_percent}}% of the sale price.\nTerm: {{start_date|date}} to {{end_date|date}}.\n\nSigned on {{today|date}}.\n"
    },
    {
      "kind": "receipt_note",
      "name": "Payment receipt note",
      "language": "en",
      "needs_legal_review": false,
      "body": "Received from {{client.name}} the sum of {{amount|money}} by {{method}} (reference {{reference}}) on {{today|date}}.\n{{company.name}}\n"
    }
  ],
  "checklists": [
    {
      "key": "uk_sale",
      "name": "Sale progression checklist",
      "applies_to": "sale",
      "needs_legal_review": true,
      "items": [
        {
          "key": "aml_id",
          "label": "Anti-money-laundering identity checks completed",
          "required": true
        },
        {
          "key": "terms_signed",
          "label": "Terms of business signed by the vendor",
          "required": true
        },
        {
          "key": "epc",
          "label": "EPC available",
          "required": true
        },
        {
          "key": "memo_of_sale",
          "label": "Memorandum of sale issued to both parties",
          "required": true
        },
        {
          "key": "conveyancer",
          "label": "Conveyancers instructed on both sides",
          "required": true
        }
      ]
    }
