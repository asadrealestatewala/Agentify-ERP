  "listing_fields": [ "bedrooms", "bathrooms", "half_baths", "garage", "lot_size", "year_built", "hoa", "property_tax" ],
  "area": {
    "default": "sqft",
    "allowed": [ "sqft", "acre", "sqm" ],
    "secondary": null,
    "labels": {
      "sqft": "Sq Ft",
      "acre": "Acres",
      "sqm": "Sq M"
    }
  },
  "rent_suffix": " / month",
  "calculators": {
    "mortgage": {
      "terms": [
        30,
        20,
        15
      ],
      "default_term": 30,
      "default_rate_bp": 650,
      "default_down_pct": 20,
      "property_tax_bp": 110,
      "insurance_annual": 150000,
      "hoa_monthly": 0,
      "pmi_bp": 50
