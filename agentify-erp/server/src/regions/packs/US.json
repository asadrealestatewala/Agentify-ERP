    "purchase_costs": "closing_costs",
    "affordability": true,
    "installments": false,
    "unit_converter": false,
    "construction": {
      "unit": "sqft",
      "rates": {
        "grey": {
          "Standard": 95,
          "Premium": 110,
          "Luxury": 130
        },
        "semi": {
          "Standard": 145,
          "Premium": 170,
          "Luxury": 200
        },
        "turnkey": {
          "Standard": 210,
          "Premium": 245,
          "Luxury": 300
        }
      },
      "scopes": {
        "grey": "Shell and structure",
        "semi": "Semi-finished",
        "turnkey": "Turnkey"
      },
      "locations": [ "Standard market", "High-cost metro" ],
      "location_factor": {
        "Standard market": 1,
        "High-cost metro": 1.25
      }
    }
  },
  "fees": {
    "closing_costs": {
      "default_bp": 300,
      "range_bp": [
        200,
        500
      ],
      "needs_legal_review": true,
      "note": "Editable percentage; state transfer tax tables follow as data."
    }
  },
  "site_copy": {
    "keyword_placeholder": "City, neighborhood, ZIP or address",
    "hero_tagline": "Homes, condos and land with transparent costs",
    "portal_blurb": "See your property, payments, receipts and documents",
    "payment_steps": [ "Pay by bank transfer (ACH or wire) or card", "Send your reference with the payment", "We confirm and issue a receipt" ]
