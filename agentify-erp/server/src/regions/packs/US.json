{
  "code": "US",
  "name": "United States",
  "status": "active",
  "version": 4,
  "locale": "en-US",
  "language": "en",
  "languages": [ "en" ],
  "currency": "USD",
  "money_scale": 2,
  "currency_style": "intl",
  "date_style": "MM/DD/YYYY",
  "time_style": "12h",
  "timezone": "America/New_York",
  "work_week": { "weekend": [0, 6], "note": "Default only; each workspace sets its own weekend in HR > Onboarding > Working calendar." },
  "units_system": "imperial",
  "distance_unit": "mi",
  "area_units": [ "sqft", "acre", "sqm" ],
  "default_area_unit": "sqft",
  "phone": {
    "calling_code": "1",
    "trunk": "1",
    "match_tail": 0,
    "national_length": [
      10
    ],
    "example": "+1 415 555 0100"
  },
  "sub_region_label": "State",
  "sub_regions": [ "Alabama", "Alaska", "Arizona", "Arkansas", "California", "Colorado", "Connecticut", "Delaware", "District of Columbia", "Florida", "Georgia", "Hawaii", "Idaho", "Illinois", "Indiana", "Iowa", "Kansas", "Kentucky", "Louisiana", "Maine", "Maryland", "Massachusetts", "Michigan", "Minnesota", "Mississippi", "Missouri", "Montana", "Nebraska", "Nevada", "New Hampshire", "New Jersey", "New Mexico", "New York", "North Carolina", "North Dakota", "Ohio", "Oklahoma", "Oregon", "Pennsylvania", "Rhode Island", "South Carolina", "South Dakota", "Tennessee", "Texas", "Utah", "Vermont", "Virginia", "Washington", "West Virginia", "Wisconsin", "Wyoming" ],
  "terminology": {
    "agent": "Realtor",
    "customer": "Client",
    "sales_agent": "Agent"
  },
  "identity": {
    "national_id": {
      "label": "SSN (last 4 shown)",
      "pattern": "^\\d{3}-?\\d{2}-?\\d{4}$",
      "encrypted": true
    }
  },
  "flags": {
    "mortgage": true,
    "transactions": false,
    "compliance": true,
    "templates": true
  },
  "rules": [],
  "notes": "Phase 1 manifest only (formats, units, terms). Rules, pipelines, templates and checklists arrive in the US phase; all legal values will be editable data marked needs_legal_review.",
  "ext_fields": [
    {
      "entity": "contact",
      "key": "residency_state",
      "label": "State of residence",
      "type": "select",
      "options": "sub_regions"
    },
    {
      "entity": "property",
      "key": "parcel_number",
      "label": "Parcel / APN number",
      "type": "text"
    },
    {
      "entity": "property",
      "key": "hoa_monthly",
      "label": "HOA fee (monthly)",
      "type": "money"
    },
    {
      "entity": "property",
      "key": "year_built",
      "label": "Year built",
      "type": "number"
    }
  ],
  "templates": [
    {
      "kind": "offer",
      "name": "Offer to purchase (sample)",
      "language": "en",
      "needs_legal_review": true,
      "body": "SAMPLE WORDING. This template is a starting point only and is not legal advice. Have it reviewed by a licensed professional in your jurisdiction before use.\n\nOFFER TO PURCHASE\n\nDate: {{today|date}}\n{{company.name}} presents this offer on behalf of {{buyer.name}} (the Buyer) to {{seller.name}} (the Seller).\n\nProperty: {{property.title}}, {{property.address}}\nOffered price: {{price|money}}\nDeposit: {{deposit|money}}\nProposed closing date: {{closing_date|date}}\n\nThis offer is subject to the conditions agreed in writing between the parties.\n"
    },
    {
      "kind": "agency_agreement",
      "name": "Agency agreement (sample)",
      "language": "en",
      "needs_legal_review": true,
      "body": "SAMPLE WORDING. This template is a starting point only and is not legal advice. Have it reviewed by a licensed professional in your jurisdiction before use.\n\nAGENCY AGREEMENT\n\n{{company.name}} is appointed by {{client.name}} (the Seller) to market {{property.title}}, {{property.address}}.\nCommission: {{commission_percent}}% of the sale price.\nTerm: {{start_date|date}} to {{end_date|date}}.\n\nSigned on {{today|date}}.\n"
    },
    {
      "kind": "receipt_note",
      "name": "Payment receipt note",
      "language": "en",
      "needs_legal_review": false,
      "body": "Received from {{client.name}} the sum of {{amount|money}} by {{method}} (reference {{reference}}) on {{today|date}}.\n{{company.name}}\n"
    }
  ],
  "checklists": [
    {
      "key": "us_purchase",
      "name": "Purchase checklist",
      "applies_to": "sale",
      "needs_legal_review": true,
      "items": [
        {
          "key": "id_verified",
          "label": "Buyer and seller identity verified",
          "required": true
        },
        {
          "key": "agreement_signed",
          "label": "Purchase agreement signed by all parties",
          "required": true
        },
        {
          "key": "earnest_money",
          "label": "Earnest money deposit received and recorded",
          "required": true
        },
        {
          "key": "inspection",
          "label": "Inspection completed or waived in writing",
          "required": false
        },
        {
          "key": "title_search",
          "label": "Title search ordered",
          "required": true
        },
        {
          "key": "closing_disclosure",
          "label": "Closing figures reviewed with the buyer",
          "required": true
        }
      ]
    }
  ],
  "price_style": "intl",
