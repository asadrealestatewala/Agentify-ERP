# Copy to server/.env. Real environment variables always win over this file.
PORT=4000
NODE_ENV=development

# --- Single company (default): leave ERP_BASE_DOMAIN empty. One database, as before.
# --- Multi-tenant SaaS: set the base domain. Each company is served at <slug>.<ERP_BASE_DOMAIN>.
#     In development use "localhost": acme.localhost:5173 resolves to your machine in modern browsers.
ERP_BASE_DOMAIN=
# Slug and display name the original install gets when it is registered as the first workspace
ERP_DEFAULT_TENANT=default
ERP_DEFAULT_TENANT_NAME=Expert Marketing & Developers

# Bearer token for the platform operator API (/api/platform/tenants). Leave empty to disable it.
ERP_PLATFORM_ADMIN_TOKEN=

# Storage (defaults are inside server/)
# ERP_DATA_DIR=./data        # platform.db and tenants/<slug>/erp.db live here
# ERP_UPLOAD_DIR=./uploads   # tenants/<slug>/ folders live here
# ERP_DB=./data/erp.db       # the original company's database

JWT_SECRET=change-me-to-a-long-random-string
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ERP_DEMO=0

# --- Email (invitations, password reset, welcome). Without a key, emails are printed to the server log instead.
# RESEND_API_KEY=
# MAIL_FROM=Agentify ERP <no-reply@yourdomain.com>

# --- Card payments with Stripe (hosted Checkout + customer portal; no SDK needed)
#     Webhook endpoint to add in Stripe: https://<your platform domain>/api/platform/billing/webhook/stripe
#     events: checkout.session.completed, customer.subscription.created/updated/deleted, invoice.paid, invoice.payment_failed
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_STARTER_MONTH=price_...
# STRIPE_PRICE_STARTER_YEAR=price_...
# STRIPE_PRICE_GROWTH_MONTH=price_...
# STRIPE_PRICE_GROWTH_YEAR=price_...
# STRIPE_PRICE_ENTERPRISE_MONTH=price_...
# STRIPE_PRICE_ENTERPRISE_YEAR=price_...

# --- Pakistani methods (paid in PKR, confirmed by you). A method shows up only if it is listed here.
#     ids: raast, easypaisa, jazzcash, sadapay, nayapay, bank
# BILLING_PK_ACCOUNTS=[{"method":"raast","account":"03001234567","name":"Your Company (Pvt) Ltd","note":"Raast ID"},{"method":"easypaisa","account":"03001234567","name":"Your Company (Pvt) Ltd"}]
# BILLING_OPERATOR_EMAIL=billing@yourdomain.com   # told when a customer says they paid

# --- Billing. manual (default): you record payments with POST /api/platform/tenants/:id/subscription.
#     generic: hosted payment links per plan + a signed webhook (see README, "Plans and billing").
BILLING_PROVIDER=manual
# BILLING_MANUAL_INSTRUCTIONS=Pay by bank transfer to ... then email the receipt to billing@yourdomain.com
# BILLING_WEBHOOK_SECRET=
# BILLING_CHECKOUT_URL_STARTER_MONTH=
# BILLING_CHECKOUT_URL_STARTER_YEAR=
# BILLING_CHECKOUT_URL_GROWTH_MONTH=
# BILLING_CHECKOUT_URL_GROWTH_YEAR=
# BILLING_CHECKOUT_URL_ENTERPRISE_MONTH=
# BILLING_CHECKOUT_URL_ENTERPRISE_YEAR=

# Platform console (/platform on the main domain)
# PLATFORM_ADMIN_EMAIL=you@example.com
# PLATFORM_ADMIN_PASSWORD=at-least-10-characters   # creates the first admin only; change it in the console
# ERP_SECRETS_KEY=long-random-string               # encrypts Stripe keys saved in the console; back it up

# Backups (snapshots of platform.db and every workspace database)
# BACKUP_DIR=./data/backups
# BACKUP_EVERY_HOURS=24
# BACKUP_KEEP=14
# BACKUP_UPLOADS=1        # also copy uploaded files (can be large)
# BACKUP_ENABLED=0        # turn off the schedule

# ---------------------------------------------------------------- SaaS release (see docs/SAAS_OPERATIONS.md)
# First platform owner: do NOT set PLATFORM_ADMIN_EMAIL/PASSWORD for new installs. Start the server, then run
#   npm run platform:setup-token     and open https://<main domain>/platform/first-run
# Email, GA4 and the alerts webhook can be configured in the console (Integrations); env values are fallbacks.
# SALES_EMAIL=sales@yourdomain.com          # receives website demo requests (else BILLING_OPERATOR_EMAIL)
# PUBLIC_FORM_LIMIT=20                      # demo / find-workspace requests per hour per IP
# PLATFORM_TZ=Asia/Karachi                  # console reporting timezone
# FreeLLMAPI (extra free AI provider, see docs/freellmapi-setup.md). The console can override all three; the key is better saved there.
# FREELLMAPI_ENABLED=0
# FREELLMAPI_BASE_URL=http://localhost:3001/v1
# FREELLMAPI_API_KEY=freellmapi-xxxxxxxx
# Placeholders only: never commit real values.
